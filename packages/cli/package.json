{
  "name": "@htmlslide/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "htmlslide": "dist/bin/htmlslide.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "htmlslide": "tsx src/bin/htmlslide.ts",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/cli"
  },
  "dependencies": {
    "@htmlslide/agent": "workspace:*",
    "@htmlslide/compiler": "workspace:*",
    "@htmlslide/core": "workspace:*",
    "@htmlslide/linter": "workspace:*",
    "@htmlslide/mcp-server": "workspace:*",
    "@htmlslide/presenter": "workspace:*",
    "@htmlslide/skills": "workspace:*",
    "commander": "^14.0.0"
  }
}
