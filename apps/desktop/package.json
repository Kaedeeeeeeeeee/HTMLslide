{
  "name": "@htmlslide/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop shell for the HTMLslide presentation workbench.",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:deps": "pnpm --filter @htmlslide/agent --filter @htmlslide/agent-adapters --filter @htmlslide/cli --filter @htmlslide/compiler --filter @htmlslide/core --filter @htmlslide/linter --filter @htmlslide/mcp-server --filter @htmlslide/presenter --filter @htmlslide/renderer --filter @htmlslide/shared-ui --filter @htmlslide/skills build",
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "pnpm build:deps && rm -rf dist/electron && vite build && tsc -p electron/tsconfig.json",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "e2e:a11y": "pnpm build && playwright test -c e2e/playwright.config.ts e2e/electron-a11y.spec.ts",
    "e2e:headed": "pnpm build && playwright test -c e2e/playwright.config.ts --headed",
    "package:alpha": "node ../../scripts/release/package-alpha.mjs",
    "typecheck": "pnpm build:deps && tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@htmlslide/agent": "workspace:*",
    "@htmlslide/agent-adapters": "workspace:*",
    "@htmlslide/compiler": "workspace:*",
    "@htmlslide/core": "workspace:*",
    "@htmlslide/mcp-server": "workspace:*",
    "@htmlslide/presenter": "workspace:*",
    "@htmlslide/shared-ui": "workspace:*",
    "@htmlslide/skills": "workspace:*",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
