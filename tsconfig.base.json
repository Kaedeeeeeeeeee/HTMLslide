{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@htmlslide/agent": ["packages/agent/src/index.ts"],
      "@htmlslide/cli": ["packages/cli/src/index.ts"],
      "@htmlslide/compiler": ["packages/compiler/src/index.ts"],
      "@htmlslide/core": ["packages/core/src/index.ts"],
      "@htmlslide/linter": ["packages/linter/src/index.ts"],
      "@htmlslide/mcp-server": ["packages/mcp-server/src/index.ts"],
      "@htmlslide/renderer": ["packages/renderer/src/index.ts"],
      "@htmlslide/shared-ui": ["packages/shared-ui/src/index.ts"],
      "@htmlslide/shared-ui/styles.css": ["packages/shared-ui/src/styles.css"]
    },
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist"
  }
}
