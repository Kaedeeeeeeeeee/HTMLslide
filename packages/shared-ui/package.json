{
  "name": "@htmlslide/shared-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared UI primitives and theme tokens for HTMLslide apps.",
  "sideEffects": [
    "src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "^5.8.3"
  }
}
