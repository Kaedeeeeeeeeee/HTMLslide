{
  "name": "@htmlslide/skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official skill metadata, registry, validation, and install planning for HTMLslide.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/skills",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
